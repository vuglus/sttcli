Windows Registry Editor Version 5.00

; For TXT files
[HKEY_CLASSES_ROOT\SystemFileAssociations\.txt\Shell\STT Summarize]
@="Summarize text with STT CLI"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.txt\Shell\STT Summarize\command]
@="powershell.exe -ExecutionPolicy Bypass -File \"%CD%\\sttcli_context.ps1\" \"%1\""

; For MD files
[HKEY_CLASSES_ROOT\SystemFileAssociations\.md\Shell\STT Summarize]
@="Summarize text with STT CLI"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.md\Shell\STT Summarize\command]
@="powershell.exe -ExecutionPolicy Bypass -File \"%CD%\\sttcli_context.ps1\" \"%1\""

; For MD files
[HKEY_CLASSES_ROOT\SystemFileAssociations\.md\Shell\STT AddContext]
@="Add context with STT CLI"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.md\Shell\STT AddContext\command]
@="powershell.exe -ExecutionPolicy Bypass -File \"%CD%\\sttcli_context.ps1\" \"%1\" join --output context.md"

; For TXT files
[HKEY_CLASSES_ROOT\SystemFileAssociations\.txt\Shell\STT Processing]
@="Process file with STT"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.txt\Shell\STT Processing\command]
@="powershell.exe -ExecutionPolicy Bypass -File \"%CD%\\sttcli_context.ps1\" \"%1\""

