; Для JSONL файлов
[HKEY_CLASSES_ROOT\SystemFileAssociations\.jsonl\Shell\STT Processing]
@="Парсить JSONL"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.jsonl\Shell\STT Processing\command]
